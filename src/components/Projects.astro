---
import { projects } from "../data/Projects";
import type { Project } from "../data/Projects";
import Card from "./Card.astro";
import SectionHeading from "./SectionHeading.astro";

const featured = projects.find((p: Project) => p.featured);
const rest = projects.filter((p: Project) => !p.featured);

const categories = [
  { id: "All", label: "All projects" },
  { id: "Web", label: "Web" },
  { id: "Mobile", label: "Mobile" },
] as const;

const counts: Record<string, number> = {
  All: projects.length,
  Web: projects.filter((p) => p.category === "Web").length,
  Mobile: projects.filter((p) => p.category === "Mobile").length,
};
---

<section
  id="projects"
  class="relative py-24 bg-white dark:bg-gray-950 overflow-hidden"
  aria-label="projects"
>
  <div class="max-w-7xl mx-auto px-6">
    <SectionHeading
      number="03"
      eyebrow="Selected work"
      titleLead="Projects"
      titleAccent="& products"
      description="A collection of products I've designed, built, and shipped — from web apps to mobile tools."
      actionAlign="end"
      class="mb-10"
    >
      <a
        slot="action"
        href="https://github.com/Hssnurrahman"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:inline-flex items-center gap-2 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
      >
        More on GitHub
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </SectionHeading>

    <!-- Filter Tabs -->
    <div
      role="tablist"
      aria-label="Filter projects by category"
      class="flex flex-wrap items-center gap-2 mb-10"
    >
      {
        categories.map((cat, i) => (
          <button
            type="button"
            role="tab"
            data-filter={cat.id}
            aria-selected={i === 0 ? "true" : "false"}
            class="filter-btn inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium border border-gray-200 dark:border-gray-800 text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:border-gray-900 dark:hover:border-white transition-colors aria-selected:bg-gray-900 aria-selected:text-white aria-selected:border-gray-900 dark:aria-selected:bg-white dark:aria-selected:text-gray-900 dark:aria-selected:border-white"
          >
            {cat.label}
            <span class="filter-count inline-flex items-center justify-center min-w-[1.25rem] h-5 px-1.5 rounded-full text-[10px] font-semibold bg-gray-100 dark:bg-gray-900 text-gray-600 dark:text-gray-400 aria-hidden:false">
              {counts[cat.id]}
            </span>
          </button>
        ))
      }
    </div>

    <!-- Projects -->
    <div id="projects-wrapper" class="space-y-6">
      {
        featured && (
          <div
            class="project-card"
            data-category={featured.category}
            data-featured="true"
          >
            <Card
              name={featured.name}
              description={featured.description}
              href={featured.href}
              tags={featured.tags}
              featured={true}
              category={featured.category}
              highlights={featured.highlights}
            />
          </div>
        )
      }

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          rest.map((project: Project) => (
            <div class="project-card" data-category={project.category}>
              <Card
                name={project.name}
                description={project.description}
                href={project.href}
                tags={project.tags}
                category={project.category}
              />
            </div>
          ))
        }
      </div>
    </div>

    <!-- Empty state -->
    <div
      id="projects-empty"
      class="hidden text-center py-20 border border-dashed border-gray-200 dark:border-gray-800 rounded-2xl mt-6"
    >
      <div
        class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-gray-100 dark:bg-gray-900 text-gray-400"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <p class="text-gray-600 dark:text-gray-400">No projects in this category yet.</p>
    </div>

    <!-- Mobile CTA -->
    <div class="md:hidden text-center mt-12">
      <a
        href="https://github.com/Hssnurrahman"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 border border-gray-200 dark:border-gray-800 text-gray-900 dark:text-white rounded-lg font-medium hover:border-gray-900 dark:hover:border-white transition-colors"
      >
        More on GitHub
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .project-card {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-card[data-visible="true"] {
    opacity: 1;
    transform: translateY(0);
  }

  .project-card[data-hidden="true"] {
    display: none;
  }

  /* Active filter pill: override count badge color so it pops on dark pill */
  .filter-btn[aria-selected="true"] .filter-count {
    background-color: rgba(255, 255, 255, 0.15);
    color: inherit;
  }

  :global(.dark) .filter-btn[aria-selected="true"] .filter-count {
    background-color: rgba(0, 0, 0, 0.15);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const cards = document.querySelectorAll<HTMLElement>(".project-card");
  const emptyState = document.getElementById("projects-empty");

  function applyFilter(filter: string) {
    let visibleCount = 0;
    cards.forEach((card) => {
      const matches = filter === "All" || card.dataset.category === filter;
      card.dataset.hidden = matches ? "false" : "true";
      if (matches) visibleCount += 1;
    });

    if (emptyState) {
      emptyState.classList.toggle("hidden", visibleCount > 0);
    }

    // Restagger visible cards
    let i = 0;
    cards.forEach((card) => {
      if (card.dataset.hidden === "true") {
        card.dataset.visible = "false";
        return;
      }
      card.dataset.visible = "false";
      const delay = i * 60;
      i += 1;
      requestAnimationFrame(() => {
        setTimeout(() => {
          card.dataset.visible = "true";
        }, delay);
      });
    });
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter ?? "All";
      buttons.forEach((b) => b.setAttribute("aria-selected", b === btn ? "true" : "false"));
      applyFilter(filter);
    });
  });

  // Initial reveal on scroll-in
  if ("IntersectionObserver" in window && cards.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const index = Array.from(cards).indexOf(el);
            setTimeout(() => {
              el.dataset.visible = "true";
            }, index * 60);
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.1 }
    );
    cards.forEach((card) => observer.observe(card));
  } else {
    cards.forEach((card) => (card.dataset.visible = "true"));
  }
</script>
