---
export interface Props {
  number: string;
  eyebrow: string;
  /** Leading text of the headline, plain. */
  titleLead: string;
  /** Optional accented phrase rendered with a gradient. Appears on a new line. */
  titleAccent?: string;
  /** Optional trailing text after the accent (rare). */
  titleTail?: string;
  description?: string;
  /** When true, render the accent on the same line instead of breaking. */
  inline?: boolean;
  /** Slot for an optional right-aligned action (e.g., a "View all" link). */
  actionAlign?: "end";
  class?: string;
}

const {
  number,
  eyebrow,
  titleLead,
  titleAccent,
  titleTail,
  description,
  inline = false,
  actionAlign,
  class: className = "",
} = Astro.props;

const hasAction = Astro.slots.has("action");
const hasDescriptionSlot = Astro.slots.has("description");
---

<div
  class:list={[
    "section-heading",
    hasAction && actionAlign === "end" && "md:flex md:items-end md:justify-between md:gap-8",
    className,
  ]}
>
  <div class="max-w-2xl">
    <!-- Eyebrow row: number + label -->
    <div class="flex items-center gap-3 mb-5">
      <span
        class="inline-flex items-center gap-2 text-xs font-mono font-semibold text-gray-500 dark:text-gray-400 tabular-nums"
      >
        <span aria-hidden="true" class="block h-px w-8 bg-gray-300 dark:bg-gray-700"></span>
        {number}
      </span>
      <span
        class="inline-block text-xs uppercase tracking-[0.22em] font-semibold text-gray-500 dark:text-gray-400"
      >
        {eyebrow}
      </span>
    </div>

    <!-- Heading -->
    <h2
      class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 dark:text-white tracking-tight leading-[1.05]"
    >
      <span>{titleLead}</span>
      {titleAccent && (
        <span
          class:list={[
            "bg-gradient-to-r from-gray-900 via-gray-700 to-gray-500 dark:from-white dark:via-gray-200 dark:to-gray-500 bg-clip-text text-transparent",
            inline ? "ml-2" : "block mt-1",
          ]}
        >
          {titleAccent}
        </span>
      )}
      {titleTail && <span> {titleTail}</span>}
    </h2>

    <!-- Underline accent -->
    <div
      class="mt-5 h-[3px] w-12 rounded-full bg-gray-900 dark:bg-white"
      aria-hidden="true"
    >
    </div>

    {hasDescriptionSlot ? (
      <div class="mt-6 text-base md:text-lg text-gray-600 dark:text-gray-400 leading-relaxed">
        <slot name="description" />
      </div>
    ) : description ? (
      <p class="mt-6 text-base md:text-lg text-gray-600 dark:text-gray-400 leading-relaxed">
        {description}
      </p>
    ) : null}
  </div>

  {hasAction && (
    <div class="mt-6 md:mt-0 md:self-end shrink-0">
      <slot name="action" />
    </div>
  )}
</div>
