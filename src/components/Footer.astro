---
import { Icon } from "astro-icon/components";
import { landingIcons } from "../data/LandingIcons";

const currentYear = new Date().getFullYear();

const quickLinks = [
  { href: "#home", label: "Home" },
  { href: "#skills", label: "Skills" },
  { href: "#projects", label: "Projects" },
  { href: "#about", label: "About" },
  { href: "#contact", label: "Contact" },
];

const socials = landingIcons
  .filter((s) => s.ariaLabel !== "email" && s.ariaLabel !== "pdf")
  .map((s) => ({
    ...s,
    iconGeneric:
      s.ariaLabel === "linkedin"
        ? "simple-icons:linkedin"
        : s.ariaLabel === "github"
          ? "simple-icons:github"
          : s.icon,
  }));

const email = "contact@hssan.dev";
---

<footer class="relative bg-gray-950 text-gray-400 border-t border-gray-900" aria-label="footer">
  <!-- Subtle top accent -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gray-700 to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="max-w-7xl mx-auto px-6">
    <!-- Top: CTA band -->
    <div
      class="py-14 border-b border-gray-900 flex flex-col md:flex-row md:items-center md:justify-between gap-6"
    >
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">
          Got a project in mind?
        </h2>
        <p class="mt-2 text-sm md:text-base text-gray-400">
          I'm always open to interesting work — drop a line anytime.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a
          href={`mailto:${email}`}
          class="group inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-white text-gray-900 font-medium hover:bg-gray-100 transition-colors"
        >
          <Icon name="mdi:email-outline" class="w-4 h-4" aria-hidden="true" />
          {email}
          <svg
            class="w-4 h-4 transition-transform group-hover:translate-x-0.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
        <a
          href="#contact"
          class="inline-flex items-center px-5 py-3 rounded-lg border border-gray-800 text-gray-200 font-medium hover:border-white hover:text-white transition-colors"
        >
          Use contact form
        </a>
      </div>
    </div>

    <!-- Middle: Brand + Links + Socials -->
    <div class="py-14 grid md:grid-cols-12 gap-10">
      <!-- Brand -->
      <div class="md:col-span-5 space-y-4">
        <a href="#home" class="group inline-flex items-center gap-2.5" aria-label="Hassan — top">
          <span
            class="flex h-9 w-9 items-center justify-center rounded-lg bg-white text-gray-900 font-bold transition-transform duration-300 group-hover:rotate-6 group-hover:scale-105"
          >
            H
          </span>
          <span class="text-xl font-semibold text-white">Hassan</span>
        </a>
        <p class="text-sm text-gray-400 max-w-sm leading-relaxed">
          Full-stack developer building web and mobile products with clean code and thoughtful UX.
        </p>
        <div class="flex items-center gap-2 pt-2 text-xs text-gray-500">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75 animate-ping"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          Available for new projects
        </div>
      </div>

      <!-- Quick Links -->
      <nav class="md:col-span-3" aria-label="Footer navigation">
        <h4 class="text-xs uppercase tracking-[0.2em] font-semibold text-gray-500 mb-4">
          Navigate
        </h4>
        <ul class="space-y-2.5 list-none p-0 m-0">
          {
            quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="group inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-white transition-colors"
                >
                  <span class="h-px w-0 bg-white transition-all duration-300 group-hover:w-3" aria-hidden="true" />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Connect -->
      <div class="md:col-span-4">
        <h4 class="text-xs uppercase tracking-[0.2em] font-semibold text-gray-500 mb-4">
          Connect
        </h4>
        <div class="flex flex-wrap gap-2 mb-5">
          {
            socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.ariaLabel}
                class="flex h-10 w-10 items-center justify-center rounded-lg border border-gray-800 text-gray-300 hover:text-gray-900 hover:bg-white hover:border-white hover:-translate-y-0.5 transition-all"
              >
                <Icon name={s.iconGeneric} class="w-4 h-4" />
              </a>
            ))
          }
        </div>
        <p class="text-xs text-gray-500 leading-relaxed">
          Based in Rawalpindi, Pakistan (PKT · UTC+5) — open to remote work worldwide.
        </p>
      </div>
    </div>

    <!-- Bottom: meta -->
    <div
      class="py-6 border-t border-gray-900 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs"
    >
      <p class="text-gray-500">
        © {currentYear} Hassan Ur Rahman. All rights reserved.
      </p>
      <div class="flex items-center gap-4 text-gray-500">
        <span class="inline-flex items-center gap-1.5">
          Built with
          <a
            href="https://astro.build"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 hover:text-white transition-colors"
          >
            <Icon name="simple-icons:astro" class="w-3.5 h-3.5" />
            Astro
          </a>
          <span aria-hidden="true">·</span>
          <a
            href="https://tailwindcss.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 hover:text-white transition-colors"
          >
            <Icon name="simple-icons:tailwindcss" class="w-3.5 h-3.5" />
            Tailwind
          </a>
        </span>
        <a
          href="#home"
          aria-label="Back to top"
          class="group inline-flex items-center gap-1.5 text-gray-500 hover:text-white transition-colors"
        >
          Back to top
          <span
            class="flex h-6 w-6 items-center justify-center rounded-full border border-gray-800 group-hover:border-white transition-colors"
          >
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</footer>
