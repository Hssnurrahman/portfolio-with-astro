---
export interface Props {
  name: string;
  description: string;
  href?: string;
  tags?: string[];
  featured?: boolean;
  category?: string;
  highlights?: string[];
}

const {
  name,
  description,
  href,
  tags = [],
  featured = false,
  category,
  highlights = [],
} = Astro.props as Props;

const isExternal = href?.startsWith("http");
const visibleTags = featured ? tags.slice(0, 6) : tags.slice(0, 4);
const extraCount = tags.length - visibleTags.length;
const hostname = (() => {
  if (!href || !isExternal) return null;
  try {
    return new URL(href).hostname.replace(/^www\./, "");
  } catch {
    return null;
  }
})();
---

<a
  href={href}
  target={isExternal ? "_blank" : "_self"}
  rel={isExternal ? "noopener noreferrer" : undefined}
  aria-label={`${name}${category ? ` — ${category} project` : ""}`}
  class:list={[
    "project-link group relative block h-full rounded-2xl transition-all duration-300 overflow-hidden",
    "hover:-translate-y-1",
    featured
      ? "p-8 md:p-10 bg-gray-900 dark:bg-white text-white dark:text-gray-900 hover:shadow-[0_24px_60px_-20px_rgb(0,0,0,0.5)]"
      : "p-6 border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 hover:border-gray-900 dark:hover:border-white hover:shadow-xl",
  ]}
>
  {featured && (
    <div class="pointer-events-none absolute inset-0 opacity-[0.07]" aria-hidden="true">
      <div
        class="absolute -top-24 -right-24 h-80 w-80 rounded-full bg-white dark:bg-gray-900 blur-3xl"
      />
      <div
        class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-white dark:bg-gray-900 blur-3xl"
      />
    </div>
  )}

  <div class:list={["relative flex flex-col h-full", featured && "md:flex-row md:items-stretch md:gap-10"]}>
    <div class:list={["flex flex-col", featured ? "md:flex-1" : "h-full"]}>
      <!-- Meta row: category + featured badge -->
      <div class="flex flex-wrap items-center gap-2 mb-4">
        {featured && (
          <span
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold uppercase tracking-wider bg-white/10 dark:bg-gray-900/10 text-white dark:text-gray-900 border border-white/20 dark:border-gray-900/20"
          >
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 16.8l-6.2 4.5 2.4-7.4L2 9.4h7.6z" />
            </svg>
            Featured
          </span>
        )}
        {category && (
          <span
            class:list={[
              "inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-semibold uppercase tracking-wider",
              featured
                ? "bg-white/10 dark:bg-gray-900/10 text-gray-200 dark:text-gray-700 border border-white/10 dark:border-gray-900/10"
                : "bg-gray-100 dark:bg-gray-900 text-gray-600 dark:text-gray-400",
            ]}
          >
            {category}
          </span>
        )}
      </div>

      <!-- Title + external arrow -->
      <div class="flex items-start justify-between gap-3 mb-3">
        <h3
          class:list={[
            "font-bold leading-tight",
            featured ? "text-3xl md:text-4xl" : "text-xl",
            featured ? "text-white dark:text-gray-900" : "text-gray-900 dark:text-white",
          ]}
        >
          {name}
        </h3>
        <span
          class:list={[
            "inline-flex shrink-0 items-center justify-center rounded-full transition-all duration-300 group-hover:rotate-0",
            featured ? "h-11 w-11 -rotate-12" : "h-9 w-9 -rotate-45",
            featured
              ? "bg-white dark:bg-gray-900 text-gray-900 dark:text-white group-hover:scale-110"
              : "border border-gray-200 dark:border-gray-800 text-gray-400 group-hover:text-gray-900 dark:group-hover:text-white group-hover:border-gray-900 dark:group-hover:border-white",
          ]}
          aria-hidden="true"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M7 17L17 7M17 7H9M17 7v8"
            ></path>
          </svg>
        </span>
      </div>

      <!-- Description -->
      <p
        class:list={[
          "mb-6 flex-1 leading-relaxed",
          featured ? "text-base md:text-lg max-w-xl" : "text-sm",
          featured
            ? "text-gray-300 dark:text-gray-600"
            : "text-gray-600 dark:text-gray-400",
        ]}
      >
        {description}
      </p>

      <!-- Footer: hostname + tags -->
      <div class="space-y-4 mt-auto">
        {hostname && (
          <div
            class:list={[
              "flex items-center gap-2 text-xs font-medium",
              featured
                ? "text-gray-400 dark:text-gray-500"
                : "text-gray-500 dark:text-gray-500",
            ]}
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
            </svg>
            {hostname}
          </div>
        )}

        {tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {visibleTags.map((tag: string) => (
              <span
                class:list={[
                  "text-[11px] px-2 py-1 rounded-md font-medium",
                  featured
                    ? "bg-white/10 dark:bg-gray-900/10 text-gray-100 dark:text-gray-800 border border-white/10 dark:border-gray-900/10"
                    : "bg-gray-100 dark:bg-gray-900 text-gray-700 dark:text-gray-300",
                ]}
              >
                {tag}
              </span>
            ))}
            {extraCount > 0 && (
              <span
                title={tags.slice(visibleTags.length).join(", ")}
                class:list={[
                  "text-[11px] px-2 py-1 rounded-md font-medium cursor-help",
                  featured
                    ? "bg-white/10 dark:bg-gray-900/10 text-gray-300 dark:text-gray-600 border border-white/10 dark:border-gray-900/10"
                    : "bg-gray-100 dark:bg-gray-900 text-gray-500",
                ]}
              >
                +{extraCount}
              </span>
            )}
          </div>
        )}
      </div>
    </div>

    {featured && highlights.length > 0 && (
      <div class="hidden md:flex md:w-72 lg:w-80 shrink-0 flex-col justify-between gap-6 pt-4 border-t md:border-t-0 md:border-l border-white/10 dark:border-gray-900/10 md:pl-10">
        <div>
          <p class="text-xs uppercase tracking-[0.2em] font-semibold text-gray-400 dark:text-gray-500 mb-3">
            Highlights
          </p>
          <ul class="space-y-2.5 text-sm text-gray-200 dark:text-gray-700">
            {highlights.map((h: string) => (
              <li class="flex gap-2">
                <span class="text-gray-400 dark:text-gray-500 shrink-0">→</span>
                {h}
              </li>
            ))}
          </ul>
        </div>

        <div
          class="inline-flex items-center gap-2 text-sm font-semibold text-white dark:text-gray-900 group-hover:gap-3 transition-all"
        >
          Visit project
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </div>
      </div>
    )}
  </div>
</a>
