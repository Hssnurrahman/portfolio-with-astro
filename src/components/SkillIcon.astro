---
import { Icon } from "astro-icon/components";

import "../styles/Icon.scss";

export interface IconProps {
  icon: string;
  label: string;
  ariaLabel: string;
  className: string;
}

export interface Props {
  heading: string;
  description?: string;
  categoryIcon: string;
  icons: IconProps[];
}

const { heading, description, categoryIcon, icons } = Astro.props as Props;
---

<article
  class="skill-card group relative rounded-2xl p-6 sm:p-8 bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800 transition-all duration-300 hover:border-gray-900 dark:hover:border-white hover:shadow-[0_8px_30px_rgb(0,0,0,0.08)] dark:hover:shadow-[0_8px_30px_rgb(0,0,0,0.3)]"
>
  <!-- Category Header -->
  <header class="flex items-center gap-4 mb-8 pb-6 border-b border-gray-100 dark:border-gray-900">
    <div
      class="flex h-12 w-12 items-center justify-center rounded-xl bg-gray-900 dark:bg-white text-white dark:text-gray-900 transition-transform duration-300 group-hover:rotate-6 group-hover:scale-105"
    >
      <Icon name={categoryIcon} class="w-6 h-6" aria-hidden="true" />
    </div>
    <div class="flex-1 min-w-0">
      <h3 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">
        {heading}
      </h3>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">
        {description ?? `${icons.length} technologies`}
      </p>
    </div>
    <span
      class="hidden sm:inline-flex items-center justify-center h-7 min-w-[1.75rem] px-2 rounded-full text-xs font-semibold bg-gray-100 dark:bg-gray-900 text-gray-600 dark:text-gray-400"
    >
      {icons.length}
    </span>
  </header>

  <!-- Skills Grid -->
  <ul class="grid grid-cols-3 sm:grid-cols-4 gap-3 sm:gap-4 list-none p-0 m-0">
    {
      icons.map(({ icon, label, ariaLabel, className }: IconProps) => (
        <li class="skill-item">
          <div
            class="group/tile relative flex flex-col items-center justify-center gap-2 p-3 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50/60 dark:bg-gray-900/40 hover:-translate-y-1 hover:shadow-md transition-all duration-300 cursor-default"
            title={label}
          >
            <div
              class={`skill-tile-bg absolute inset-0 rounded-xl opacity-0 group-hover/tile:opacity-100 transition-opacity duration-300 ${className}`}
              aria-hidden="true"
            />
            <Icon
              name={icon}
              class="relative z-10 w-7 h-7 text-gray-700 dark:text-gray-300 group-hover/tile:text-white transition-colors duration-300"
              aria-label={ariaLabel}
            />
            <p class="relative z-10 text-[11px] sm:text-xs font-medium text-gray-600 dark:text-gray-400 group-hover/tile:text-white transition-colors duration-300 text-center leading-tight">
              {label}
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</article>

<style>
  /* The .{name}-icon classes in Icon.scss set width + background-color.
     We only want the color here, so reset the width and let the parent fill. */
  .skill-tile-bg {
    width: 100% !important;
  }
</style>
