---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Head from "./Head.astro";
import "../global.css";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Hassan Ur Rahman | Full-Stack Developer",
  description = "Portfolio of Hassan Ur Rahman, a full-stack developer building thoughtful, scalable web and mobile products.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<Head title={title} description={description} />
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
