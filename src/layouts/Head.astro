---
export interface Props {
  title?: string;
  description?: string;
  image?: string | undefined;
  type?: "website" | "article" | undefined;
  canonical?: string;
  /** Extra JSON-LD nodes for this page, merged into the site-wide @graph. */
  structuredData?: Record<string, unknown>[] | undefined;
}

const {
  title = "Hassan Ur Rahman | Full-Stack Developer",
  description = "Portfolio of Hassan Ur Rahman, a full-stack developer building thoughtful, scalable web and mobile products.",
  image = "/og-image.png",
  type = "website",
  canonical,
  structuredData: pageStructuredData = [],
} = Astro.props;

const site = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;
const homeUrl = new URL("/", site).href;
const personId = `${homeUrl}#person`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: "Hassan Ur Rahman",
      url: homeUrl,
      image: new URL("/hassan-ur-rahman-logo-v2.png", site).href,
      jobTitle: "Full-Stack Developer",
      email: "contact@hssan.dev",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Rawalpindi",
        addressCountry: "PK",
      },
      knowsAbout: [
        "Full-stack development",
        "React",
        "Next.js",
        "Node.js",
        "TypeScript",
        "PostgreSQL",
        "Flutter",
        "Mobile app development",
      ],
      sameAs: [
        "https://github.com/Hssnurrahman",
        "https://www.linkedin.com/in/hassan-ur-rahman-03b787229/",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${homeUrl}#website`,
      name: "Hassan Ur Rahman",
      url: homeUrl,
      inLanguage: "en",
      publisher: { "@id": personId },
    },
    ...pageStructuredData,
  ],
};
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/hassan-favicon.svg" />
  <link rel="icon" type="image/png" sizes="16x16" href="/hassan-favicon-16.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/hassan-favicon-32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/hassan-apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={description} />
  <script is:inline>
    (() => {
      const storageKey = 'theme-preference';
      let preference = 'system';
      try {
        const saved = localStorage.getItem(storageKey);
        if (saved === 'light' || saved === 'dark' || saved === 'system') preference = saved;
      } catch {}

      const isDark = preference === 'dark' || (
        preference === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches
      );
      document.documentElement.classList.toggle('dark', isDark);
      document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
      document.documentElement.dataset.theme = preference;
    })();
  </script>
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="Hassan Ur Rahman" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <title>{title}</title>
</head>
