---
import Layout from "../../layouts/Layout.astro";
import { projects, projectSlug } from "../../data/Projects";
import type { Project } from "../../data/Projects";

export const prerender = true;

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: projectSlug(project) },
    props: { project },
  }));
}

const { project } = Astro.props as { project: Project };
const details = project.details;

const kind = project.category === "Mobile" ? "mobile app" : "web app";
const isPlayStore = project.href.includes("play.google.com");
const linkLabel = isPlayStore ? "Get it on Google Play" : "Visit live site";
const others = projects.filter((p) => p !== project).slice(0, 3);

// Keep the meta description inside the ~155 characters search engines display.
const metaDescription = (() => {
  const text = `${project.name}: ${details?.tagline ?? project.description}`;
  if (text.length <= 155) return text;
  return `${text.slice(0, 152).replace(/\s+\S*$/, "")}…`;
})();

const site = Astro.site ?? Astro.url.origin;
const homeUrl = new URL("/", site).href;
const pageUrl = new URL(Astro.url.pathname, site).href;

const structuredData = [
  {
    "@type": "SoftwareApplication",
    name: project.name,
    description: project.description,
    url: project.href,
    applicationCategory: project.category === "Mobile" ? "MobileApplication" : "WebApplication",
    operatingSystem: project.category === "Mobile" ? "Android" : "Web",
    keywords: project.tags.join(", "),
    author: { "@id": `${homeUrl}#person` },
    // Required by Google for SoftwareApplication; all listed apps are free.
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: homeUrl },
      { "@type": "ListItem", position: 2, name: "Projects", item: `${homeUrl}#projects` },
      { "@type": "ListItem", position: 3, name: project.name, item: pageUrl },
    ],
  },
];
---

<Layout
  title={`${project.name} — ${project.category} Project | Hassan Ur Rahman`}
  description={metaDescription}
  type="article"
  structuredData={structuredData}
>
  <main class="bg-white dark:bg-gray-950 pt-32 pb-24">
    <article class="max-w-4xl mx-auto px-6">
      <nav aria-label="Breadcrumb" class="mb-8 text-sm text-gray-500 dark:text-gray-400">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-gray-900 dark:hover:text-white transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/#projects" class="hover:text-gray-900 dark:hover:text-white transition-colors">Projects</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-gray-900 dark:text-white font-medium">{project.name}</li>
        </ol>
      </nav>

      <span
        class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-semibold uppercase tracking-wider bg-gray-100 dark:bg-gray-900 text-gray-600 dark:text-gray-400"
      >
        {project.category}
      </span>

      <h1 class="mt-4 text-4xl md:text-6xl font-bold tracking-tight text-gray-900 dark:text-white">
        {project.name}
      </h1>
      <p class="mt-4 text-xl md:text-2xl text-gray-700 dark:text-gray-300">
        {details?.tagline ?? project.description}
      </p>
      <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">
        A {kind} designed and built by Hassan Ur Rahman.
      </p>

      {
        details && (
          <section class="mt-12" aria-labelledby="overview-heading">
            <h2 id="overview-heading" class="text-2xl font-bold text-gray-900 dark:text-white">
              Overview
            </h2>
            <div class="mt-4 space-y-4 text-lg leading-relaxed text-gray-700 dark:text-gray-300">
              {details.overview.map((para) => <p>{para}</p>)}
            </div>
          </section>
        )
      }

      {
        details && (
          <section class="mt-12" aria-labelledby="features-heading">
            <h2 id="features-heading" class="text-2xl font-bold text-gray-900 dark:text-white">
              Key features
            </h2>
            <ul class="mt-6 grid sm:grid-cols-2 gap-4">
              {details.features.map((f) => (
                <li class="p-5 rounded-xl border border-gray-200 dark:border-gray-800">
                  <h3 class="font-semibold text-gray-900 dark:text-white">{f.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-400">{f.description}</p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        details && (
          <section class="mt-12" aria-labelledby="technical-heading">
            <h2 id="technical-heading" class="text-2xl font-bold text-gray-900 dark:text-white">
              How it's built
            </h2>
            <ul class="mt-4 space-y-3 text-gray-700 dark:text-gray-300 leading-relaxed">
              {details.technical.map((t) => (
                <li class="flex gap-3">
                  <span class="text-gray-400 dark:text-gray-500 shrink-0" aria-hidden="true">→</span>
                  {t}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        details?.challenges && details.challenges.length > 0 && (
          <section class="mt-12" aria-labelledby="challenges-heading">
            <h2 id="challenges-heading" class="text-2xl font-bold text-gray-900 dark:text-white">
              Challenges &amp; solutions
            </h2>
            <dl class="mt-6 space-y-6">
              {details.challenges.map((c) => (
                <div class="pl-5 border-l-2 border-gray-200 dark:border-gray-800">
                  <dt class="font-semibold text-gray-900 dark:text-white">{c.title}</dt>
                  <dd class="mt-2 text-gray-600 dark:text-gray-400 leading-relaxed">{c.solution}</dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      {
        !details && project.highlights && project.highlights.length > 0 && (
          <section class="mt-12" aria-labelledby="highlights-heading">
            <h2 id="highlights-heading" class="text-2xl font-bold text-gray-900 dark:text-white">
              Highlights
            </h2>
            <ul class="mt-4 space-y-3 text-gray-700 dark:text-gray-300">
              {project.highlights.map((h) => (
                <li class="flex gap-3">
                  <span class="text-gray-400 dark:text-gray-500 shrink-0" aria-hidden="true">→</span>
                  {h}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="mt-12" aria-labelledby="stack-heading">
        <h2 id="stack-heading" class="text-2xl font-bold text-gray-900 dark:text-white">
          Tech stack
        </h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            project.tags.map((tag) => (
              <li class="text-sm px-3 py-1.5 rounded-md font-medium bg-gray-100 dark:bg-gray-900 text-gray-700 dark:text-gray-300">
                {tag}
              </li>
            ))
          }
        </ul>
      </section>

      <div class="mt-12 flex flex-col sm:flex-row gap-3">
        <a
          href={project.href}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg font-medium hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors"
        >
          {linkLabel}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 17L17 7M17 7H9M17 7v8"></path>
          </svg>
        </a>
        <a
          href="/#contact"
          class="inline-flex items-center justify-center gap-2 px-7 py-3.5 border border-gray-200 dark:border-gray-800 text-gray-900 dark:text-white rounded-lg font-medium hover:border-gray-900 dark:hover:border-white transition-colors"
        >
          Work with me
        </a>
      </div>

      <section class="mt-20 pt-12 border-t border-gray-200 dark:border-gray-800" aria-labelledby="more-heading">
        <h2 id="more-heading" class="text-2xl font-bold text-gray-900 dark:text-white">
          More projects
        </h2>
        <ul class="mt-6 grid sm:grid-cols-3 gap-4">
          {
            others.map((p) => (
              <li>
                <a
                  href={`/projects/${projectSlug(p)}/`}
                  class="block h-full p-5 rounded-xl border border-gray-200 dark:border-gray-800 hover:border-gray-900 dark:hover:border-white transition-colors"
                >
                  <span class="block text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">
                    {p.category}
                  </span>
                  <span class="mt-1 block font-semibold text-gray-900 dark:text-white">{p.name}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </article>
  </main>
</Layout>
