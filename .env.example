# Resend API Configuration
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Your contact email where you want to receive messages
CONTACT_EMAIL=hassan@example.com

# Humkalam Agora token endpoint (POST /api/humkalam/agora-token)
# App ID and App Certificate from the Agora console (Secure mode). The certificate is a
# secret: set it only in Vercel environment variables, never commit a real value.
HUMKALAM_AGORA_APP_ID=your_agora_app_id_here
HUMKALAM_AGORA_APP_CERTIFICATE=your_agora_app_certificate_here
HUMKALAM_FIREBASE_PROJECT_ID=your_firebase_project_id_here
